+ const mutant=process.env.B1_FAULT==='C'?source.replace('function validateEnvelope(v){','function validateEnvelope(v){return;'):source;
+ const bad=await ready(harness(envelope(true,true),mutant));
+ bad.nodes.get('#download').onclick();
+ assert.strictEqual(bad.downloads.length,0,'CSS-ONLY MASK EXPORTED CHEMISTRY');
+ assert(!text(bad.nodes.get('#channels')||new Element('div')).includes('0.7312346'),'CSS-ONLY MASK LEFT CHEMISTRY IN DOM');
+ assert.strictEqual(bad.nodes.get('#send').disabled,true);
+ const hidden=await ready(harness(envelope(true)));
+ hidden.nodes.get('#download').onclick();
+ const exported=JSON.parse(hidden.downloads[0]);
+ assert.strictEqual(exported.history[0].raw.length,25);assert(!hidden.downloads[0].includes(String(canary)));
+ assert(!text(hidden.nodes.get('#channels')).includes('0.7312346'));
+ assert(text(hidden.nodes.get('#channels')).includes('CHEMISTRY UNAVAILABLE IN THIS CONDITION'));
+ // Delayed browser response and double-click cause exactly one POST.
+ hidden.nodes.get('#send').onclick();hidden.nodes.get('#send').onclick();
+ assert.strictEqual(hidden.calls.filter(c=>c.options?.method==='POST').length,1);
+ assert.strictEqual(hidden.nodes.get('#send').disabled,true);
+ assert(hidden.nodes.get('#state').textContent.startsWith('RUNNING'));
+ hidden.resolve(envelope(true,false,'paused'));await ready(hidden);
+ assert.strictEqual(hidden.nodes.get('#state').textContent,'PAUSED');assert.strictEqual(hidden.nodes.get('#send').disabled,false);
+ // Even a fast first response must not turn the browser's second double-click
+ // event or held-key repeat into a fresh decision with the new token.
+ hidden.nodes.get('#send').onclick({detail:2});
+ assert.strictEqual(hidden.calls.filter(c=>c.options?.method==='POST').length,1);
+ let prevented=false;hidden.nodes.get('#send').onkeydown({repeat:true,preventDefault(){prevented=true;}});assert(prevented);
+ // Refresh/reconnect is only a GET; end remains non-actionable.
+ const before=hidden.calls.filter(c=>c.options?.method==='POST').length;
+ await hidden.nodes.get('#refresh').onclick();await ready(hidden);
+ assert.strictEqual(hidden.calls.filter(c=>c.options?.method==='POST').length,before);
+ const ended=await ready(harness(envelope(true,false,'ended')));ended.nodes.get('#send').onclick();
+ assert.strictEqual(ended.calls.filter(c=>c.options?.method==='POST').length,0);
+ assert.strictEqual(ended.nodes.get('#state').textContent,'ENDED');
+ const full=await ready(harness(envelope(false)));full.nodes.get('#download').onclick();
+ assert.strictEqual(JSON.parse(full.downloads[0]).history[0].raw.length,29);assert(full.downloads[0].includes(String(canary)));
+ assert(text(full.nodes.get('#channels')).includes('0.7312346'));
+ const prepared=await ready(harness(envelope(true,false,'prepared')));
+ assert.strictEqual(prepared.nodes.get('#send').disabled,true);assert.strictEqual(prepared.nodes.get('#start').disabled,false);
+ prepared.nodes.get('#start').onclick();assert(prepared.nodes.get('#state').textContent.startsWith('PREPARED'));
+ console.log('DOM canary, downloadable data, FULL-RAW, lifecycle, delayed response, double click and refresh checks passed.');
+})().catch(error=>{console.error(error.message);process.exitCode=1;});
