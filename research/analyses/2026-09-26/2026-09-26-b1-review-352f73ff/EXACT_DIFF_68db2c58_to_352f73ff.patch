+class Element{
+ constructor(tag){this.tag=tag;this.children=[];this.textContent='';this.disabled=false;this.value=0;this.max=0;this.attrs={};}
+ append(...c){this.children.push(...c);}replaceChildren(...c){this.children=c;}setAttribute(k,v){this.attrs[k]=v;}
+ getContext(){return {beginPath(){},lineTo(){},moveTo(){},stroke(){}};}click(){if(this.onclick)return this.onclick();}
+}
+function harness(value,js=source){
+ const nodes=new Map(),calls=[],downloads=[],timers=[];let pending=null;
+ const document={querySelector(sel){if(!nodes.has(sel))nodes.set(sel,new Element('div'));return nodes.get(sel);},createElement(tag){return new Element(tag);}};
+ const context=vm.createContext({document,console,Number,JSON,Math,Array,Error,Blob:class{constructor(parts){this.parts=parts;}},
+ URL:{createObjectURL(b){downloads.push(b.parts.join(''));return 'blob:fixture';},revokeObjectURL(){}},setInterval(fn){timers.push(fn);},
+ fetch(url,options){calls.push({url,options});if(options&&options.method==='POST')return new Promise(resolve=>{pending=resolve;});return Promise.resolve({ok:true,json:async()=>JSON.parse(JSON.stringify(value))});}});
+ vm.runInContext(js,context);
+ return {nodes,calls,downloads,timers,context,resolve(v){const p=pending;pending=null;p({ok:true,json:async()=>v});}};
+}
+const flush=()=>new Promise(resolve=>setImmediate(resolve));
+async function ready(h){await flush();await flush();return h;}
+function text(node){return String(node.textContent)+' '+node.children.map(text).join(' ');}
