+"""A-R1/A-R2 only. Synthetic grants are validation inputs, never execution approval."""
+import copy
+from decimal import Decimal, ROUND_HALF_EVEN
+import gzip
+import json
+import math
+import os
+from pathlib import Path
+from unittest.mock import patch
+import numpy as np
+import pytest
+from test_apparatus import manufactured
+from loom_p.records import state_hash, strict_bytes
+from loom_p.chemistry import FieldSolver
+from loom_commissioning import authority, controllers, runner
+from loom_commissioning.contract import *
+from loom_commissioning.initialization import from_verified_cache
+from loom_commissioning.validators import read_stream, verify_segment
+
+PLAN=[{'point':[6.,5.],'until':.1,'press_force':0.}, {'point':[5.,6.],'until':.2,'press_force':0.}]
+HERE=Path(__file__).parent
+
+def fault(name): return os.environ.get('CORRECTION_FAULT')==name
+
+def grant_fixture(tmp_path):
+    cache=HERE.parent/'artifacts/prehistory-attempt-001'
+    e,init=from_verified_cache(cache,0)  # existing cache, no preparation/advancement
+    m=make_manifest(e,'authority-validation-only',EXTERNAL,'waypoint',.2,
+                    purpose='commissioning',initialization=init,plan=PLAN)
+    payload={'notice':'SYNTHETIC VALIDATION ONLY. NOT JASON APPROVAL. NO EXECUTION.',
+             'approved_execution':authority.execution_object(m),
+             'approved_execution_sha256':authority.execution_sha256(m)}
+    p=tmp_path/'synthetic-NOT-AUTHORITY.json'; p.write_bytes(authority.canonical(payload))
+    m['execution_authority']={'request_path':str(p),'request_sha256':digest(p.read_bytes()),
+        'approved_case':m['case_id'],'approved_initial_state':m['initial_state'],
+        'approved_duration':m['duration_seconds'],'approved_execution_sha256':authority.execution_sha256(m)}
+    return e,m,p
+
+def rejected(fn):
+    try: fn()
+    except ValueError: return True
+    return False
+
+AUTHORITY_FAULTS=('implementation','constants','route','stage_sequence','contact_target','manual_fallback',
+    'sensor_interface','intact_arm','fixed_adapter','deprivation','initial','prehistory','duration',
+    'resources','runtime','procedure','replay_arm','request_rebind')
+
+def substitute(m,name):
+    x=m['execution']
+    if name=='implementation': x['controller']['implementation']['controllers.py']='f'*64
+    elif name=='constants': x['controller']['configuration']['force_gain']=.41
+    elif name=='route': x['procedure']['stages'][0]['point']=[4.,5.]
+    elif name=='stage_sequence': x['procedure']['stages'][0]['point'],x['procedure']['stages'][1]['point']=x['procedure']['stages'][1]['point'],x['procedure']['stages'][0]['point']
+    elif name=='contact_target': x['procedure']['stages'][0]['press_force']=.1
+    elif name in ('manual_fallback','sensor_interface','intact_arm','fixed_adapter','replay_arm'):
+        mode,kind={'manual_fallback':(EXTERNAL,'manual_privileged'),'sensor_interface':(EXTERNAL,'sensor_human'),
+                   'intact_arm':(INTACT,'none'),'fixed_adapter':(FIXED,'none'),'replay_arm':(EXTERNAL,'waypoint')}[name]
+        m.update(mode=mode,controller=kind)
+        m['execution']=authority.make_execution(mode,kind,plan=PLAN if kind=='waypoint' else None,
+            protocol={'steps':[{'action':'bounded-interface-entry'}]})
+        if name=='replay_arm': m['case_id']='otherwise-compatible-other-arm'
+    elif name=='deprivation': x['display_intervention']={'kind':'chemistry_hidden'}
+    elif name=='initial': m['initial_state']='1'*64
+    elif name=='prehistory': m['initialization']['cache_receipt_sha256']='2'*64
+    elif name=='duration': m['duration_seconds']=.3; m['hard_stop_time']=m['initial_time']+.3
+    elif name=='resources': x['resources']['wall_limit_seconds']+=1
+    elif name=='runtime': x['runtime']['executable_sha256']='3'*64
+    elif name=='procedure': x['procedure']['protocol']={'steps':[{'action':'unapproved-wait'}]}
+    elif name=='request_rebind':
+        x['procedure']['stages'][0]['point']=[4.,5.]
+        # Even updating the grant's digest cannot rewrite the immutable request.
+        m['execution_authority']['approved_execution_sha256']=authority.execution_sha256(m)
+    else: raise AssertionError(name)
+
+@pytest.mark.parametrize('name',AUTHORITY_FAULTS)
+def test_approved_execution_binding(tmp_path,name):
+    e,m,p=grant_fixture(tmp_path); before=state_hash(e); saved=p.read_bytes()
+    validate_manifest(m,e); authorize_execution(m)  # positive validation only
+    other=copy.deepcopy(m); substitute(other,name)
+    # Isolate the new complete binding, so old case/duration guards cannot make
+    # this consequential test pass vacuously. All other grant bytes stay fixed.
+    check=(lambda:None) if fault('authority-'+name) else lambda:authority.verify_approval_binding(other,other['execution_authority'])
+    assert rejected(check), 'APPROVAL BINDING BREACH: '+name
+    # Full entry point must fail before a recorder/trajectory can be created.
+    output=tmp_path/'MUST-NOT-EXIST'
+    with patch.object(runner,'Recorder',side_effect=AssertionError('trajectory output created')):
+        assert rejected(lambda:runner.Run(e,other,output)), 'pre-output rejection failed'
+    assert not output.exists() and p.read_bytes()==saved and state_hash(e)==before and e.native_index==0
+    authorize_execution(m)  # exact approved validation control, never a Run
+
+def test_canonical_identity_and_live_program_guard(tmp_path):
+    e,m,p=grant_fixture(tmp_path)
+    reordered=dict(reversed(list(m.items())))
+    assert authority.execution_sha256(reordered)==authority.execution_sha256(m)
+    authorize_execution(reordered)
+    with patch.dict(controllers.WAYPOINT_SETTINGS,{'heading_gain':.81}):
+        with pytest.raises(ValueError,match='controller execution identity'): authorize_execution(m)
+    with patch.object(controllers,'waypoint_command',lambda data,plan,cursor:([0,0],cursor)):
+        with pytest.raises(ValueError,match='controller execution identity'): authorize_execution(m)
+    authorize_execution(m)
+
+def test_route_and_resources_rejected_before_output(tmp_path):
+    e=manufactured(); m=make_manifest(e,'fixture-bound-route',EXTERNAL,'waypoint',.2,plan=PLAN)
+    wrong=copy.deepcopy(PLAN); wrong[0]['point']=[4.,5.]
+    for kwargs in ({'plan':wrong},{'wall_limit':3601},{'storage_limit':999999999},{'observer':lambda *args:None}):
+        with pytest.raises(ValueError): runner.Run(e,m,tmp_path/'forbidden',**kwargs)
+        assert not (tmp_path/'forbidden').exists() and e.native_index==0
+    run=runner.Run(e,m,tmp_path/'correct',plan=PLAN)
+    before=state_hash(e)
+    run.wall_limit+=1
+    with pytest.raises(ValueError,match='live resources'): run.begin_command()
+    run.wall_limit-=1
+    run.session['route'][0]['point']=[4.,5.]
+    with pytest.raises(ValueError,match='session route'): run.begin_command()
+    assert state_hash(e)==before and not read_stream_after_flush(run,'controller')
+    run.session['route']=copy.deepcopy(PLAN); run.close()
+    _,s,_=runner.load_restart(tmp_path/'correct/final.restart.json.gz')
+    s['route']=wrong
+    with pytest.raises(ValueError,match='session route'):
+        runner.Run(e,m,tmp_path/'bad-resume',session=s)
+    assert not (tmp_path/'bad-resume').exists()
+
+def read_stream_after_flush(run,name):
+    # No command write occurred; don't read a still-open gzip trailer.
+    return run.sensor.payload['own_commands']
+
+def review_input():
+    return json.loads((HERE/'fixtures/review-boundary-input.json').read_bytes())
+
+def old_due(now,deadline): return now>=deadline
+
+def independent_tick(time):
+    # Decimal integer native-step oracle, independent of production isclose.
+    # The adjacent-ULP values are representations of native decision tick 10.
+    return int((Decimal.from_float(time)/Decimal('0.01')).to_integral_value(rounding=ROUND_HALF_EVEN))
+
+@pytest.mark.parametrize('time',[0.09999999999999999,math.nextafter(.1,-math.inf),.1,math.nextafter(.1,math.inf),.1+5e-11])
+def test_exact_review_boundary(time):
+    data=review_input(); assert data['time']==0.09999999999999999
+    data['time']=time
+    assert independent_tick(time)==10
+    # A stage owns ticks [0,10); next stage owns [10,20).
+    with patch.object(controllers,'time_due',old_due if fault('clock-transition') else controllers.time_due):
+        cmd,cursor=controllers.waypoint_command(data,PLAN,0)
+        assert cursor==1, 'CLOCK BREACH: expired stage issued another hold'
+    exact=copy.deepcopy(data); exact['time']=.1
+    oracle,_=controllers.waypoint_command(exact,PLAN,0)
+    assert np.array_equal(cmd,oracle)
+
+def test_final_stage_and_not_due_control():
+    data=review_input()
+    with patch.object(controllers,'time_due',old_due if fault('clock-final') else controllers.time_due):
+        cmd,_=controllers.waypoint_command(data,PLAN[:1],0)
+        assert not cmd.any(), 'CLOCK BREACH: final stage still drives'
+    data['time']=.09
+    cmd,cursor=controllers.waypoint_command(data,PLAN,0)
+    assert independent_tick(.09)==9 and cursor==0 and cmd.any()
+    # Just outside the declared timing tolerance remains genuinely not due.
+    data['time']=.1-2e-10
+    assert controllers.waypoint_command(data,PLAN,0)[1]==0
+
+def test_full_hold_cannot_cross_stage(tmp_path):
+    e=manufactured(); plan=copy.deepcopy(PLAN); plan[0]['until']=.05
+    m=make_manifest(e,'fixture-crossing',EXTERNAL,'waypoint',.2,plan=plan)
+    run=runner.Run(e,m,tmp_path/'crossing'); before=state_hash(e)
+    with pytest.raises(ValueError,match='cross prescribed stage'): run.begin_command()
+    assert not run.sensor.payload['own_commands'] and run.session['hold_remaining']==0 and state_hash(e)==before
+    run.close()
+
+@pytest.mark.parametrize('pause_index',[7,10])
+def test_boundary_resume_counts_and_absolute_cap(tmp_path,pause_index):
+    start=manufactured(); m=make_manifest(start,'fixture-corrected-boundary',EXTERNAL,'waypoint',.2,plan=PLAN)
+    first=runner.Run(copy.deepcopy(start),m,tmp_path/'first'); first.begin_command(); first.advance(pause_index)
+    assert first.engine.native_index==pause_index and first.session['hold_remaining']==10-pause_index
+    first.close(); resumed=runner.Run.resume(tmp_path/'first',tmp_path/'resumed')
+    if pause_index==7: resumed.hold()
+    assert resumed.engine.native_index==10 and resumed.engine.time==0.09999999999999999
+    resumed.begin_command()
+    assert resumed.session['cursor']==1 and resumed.session['hold_remaining']==10
+    resumed.advance(10)
+    continuous=runner.Run(copy.deepcopy(start),m,tmp_path/'continuous')
+    fields=[]; real=FieldSolver.step; neural=state_hash(start.organism)
+    def count(self,*args,**kwargs): fields.append(args[4]); return real(self,*args,**kwargs)
+    with patch.object(FieldSolver,'step',count): continuous.hold(); continuous.hold()
+    assert fields==[.01]*20 and continuous.engine.native_index==20
+    assert independent_tick(continuous.engine.time)==20
+    assert abs(Decimal.from_float(continuous.engine.time)-Decimal('0.20'))<Decimal('1e-15')
+    assert state_hash(continuous.engine)==state_hash(resumed.engine)
+    assert state_hash(continuous.engine.organism)==neural # includes RNG, native/wave counters
+    for name in ('first','resumed','continuous'): verify_segment(tmp_path/name)
+    assert read_stream(tmp_path/'continuous/wave.jsonl.gz')==[]
+    assert [r['hold_native_steps'] for r in read_stream(tmp_path/'continuous/controller.jsonl.gz')]==[10,10]
+    with pytest.raises(ValueError): resumed.hold()
+    assert resumed.engine.native_index==20
+
+def test_final_boundary_resume_cannot_gain_hold(tmp_path):
+    e=manufactured(); m=make_manifest(e,'fixture-final-boundary',EXTERNAL,'waypoint',.2,plan=PLAN[:1])
+    first=runner.Run(e,m,tmp_path/'first'); first.hold(); first.close()
+    resumed=runner.Run.resume(tmp_path/'first',tmp_path/'resumed'); before=state_hash(resumed.engine)
+    with pytest.raises(ValueError,match='route complete'): resumed.hold()
+    assert resumed.session['hold_remaining']==0 and resumed.engine.native_index==10 and state_hash(resumed.engine)==before
+    assert resumed.sensor.payload['own_commands']==first.sensor.payload['own_commands']
+    resumed.close()
