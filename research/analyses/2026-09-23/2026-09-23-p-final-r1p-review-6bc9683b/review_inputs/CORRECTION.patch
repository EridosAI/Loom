+"""R1-P fixed state falsifiers. No new complete-loop case or parameter sweep."""
+import copy
+from types import SimpleNamespace
+import numpy as np
+import pytest
+from scipy.optimize import brentq
+from loom_p.schema import Config
+from loom_p.physics import Body,advance
+from loom_p.engine import Engine
+
+CASES=[
+    pytest.param(.01,1e-5,1.,id='review-exact'),
+    pytest.param(.02,1e-5,1.,id='different-normal-force'),
+    pytest.param(.01,2e-5,-1.,id='reflected-longer-flight'),
+]
+
+def fixture(normal_force,outward_speed,side):
+    c=Config(); angle=float(side*np.arccos(normal_force/.76))
+    b=Body(np.array([2.,3.]),angle,velocity=np.array([-outward_speed,0.]))
+    return c,b,np.full(8,.2)
+
+def gap_oracle(c,b,s):
+    # Independent analytic transcription of the selected p(s)=p0+s*v(s).
+    # No production free_velocity, actuator_forces, gap_normal or release_probe.
+    force=.76*np.array([np.cos(b.angle),np.sin(b.angle)])
+    decay=np.exp(-s*c.linear_drag/c.body_mass)
+    velocity=b.velocity*decay+force/c.linear_drag*(-np.expm1(-s*c.linear_drag/c.body_mass))
+    delta=b.position+s*velocity-np.array([3.,3.])
+    return float(np.linalg.norm(delta)-1.)
+
+@pytest.mark.parametrize('normal_force,outward_speed,side',CASES)
+def test_oblique_release_free_return_and_accounting(normal_force,outward_speed,side):
+    c,b,stocks=fixture(normal_force,outward_speed,side); initial=copy.deepcopy(b)
+    characteristic=outward_speed/normal_force
+    peak_sample=characteristic/2
+    assert gap_oracle(c,b,peak_sample)>10*c.geometry_tol
+    if normal_force==.01 and outward_speed==1e-5:
+        assert gap_oracle(c,b,.0005)==pytest.approx(2.4981434698645444e-9,rel=0,abs=3e-16)
+    tol_return=brentq(lambda s:gap_oracle(c,b,s)-c.geometry_tol,peak_sample,2*characteristic,xtol=c.event_time_tol/10)
+    zero_return=brentq(lambda s:gap_oracle(c,b,s),peak_sample,2*characteristic,xtol=c.event_time_tol/10)
+    events,elapsed,terminal=advance(c,b,stocks,0.,0.,np.ones(2),.01)
+    releases=[r for r in events if r.get('event_kind')=='release']
+    flights=[r for r in events if r['duration']>0 and not r['contacts']]
+    returns=[r for r in events if r.get('event_kind')=='recontact_or_first_touch']
+    assert len(releases)==1 and len(flights)==1, 'R1-P: resolvable free flight was charged as contact'
+    assert releases[0]['time']==0. and len(returns)==1
+    assert tol_return-5*c.event_time_tol<=flights[0]['duration']<=zero_return+5*c.event_time_tol
+    assert returns[0]['time']==flights[0]['time']
+    assert any(x['collider']=='source-0' for x in returns[0]['contacts'])
+    sustained=[r for r in events if r['duration']>0 and r['contacts']]
+    assert len(sustained)==1 and sustained[0]['duration']==pytest.approx(.01-flights[0]['duration'],rel=0,abs=1e-16)
+    assert elapsed==pytest.approx(.01,rel=0,abs=1e-16) and terminal is None
+    assert sum(r['duration'] for r in events)==pytest.approx(.01,rel=0,abs=1e-16)
+    for r in events:
+        transfer=np.asarray(r['transfer']); duration=r['duration']
+        assert r['energy_after']-r['energy_before']==pytest.approx(transfer.sum()-r['expenditure'],rel=0,abs=2e-16)
+        assert np.allclose(r['stock_after']-r['stock_before'],r['renewal_first']+r['renewal_second']-transfer,rtol=0,atol=2e-16)
+        damage=c.damage_per_impulse*sum(x['impulse'] if r['impact'] else max(x['impulse']-c.stress_threshold*duration,0) for x in r['contacts'])
+        assert r['damage']==pytest.approx(damage,rel=0,abs=1e-16)
+        assert r['integrity_after']-r['integrity_before']==pytest.approx(r['repair']-damage,rel=0,abs=2e-16)
+        if r['impact'] or not r['contacts']:
+            assert transfer.sum()==0. and r['repair']==0.
+        if not r['contacts']: assert r['damage']==0.
+        if duration>0:
+            assert r['expenditure']==pytest.approx((c.basal_cost+c.effort_cost)*duration,rel=0,abs=1e-18)
+            quality=np.zeros(8)
+            for contact in r['contacts']:
+                force=contact['impulse']/duration
+                if 'source' in contact:
+                    quality[contact['source']]=force/(force+c.exchange_force_scale)/(1+(contact['relative_speed']/c.exchange_speed_scale)**2)
+            expected=c.uptake_rate*((r['stock_before']+r['renewal_first'])/c.source_capacity)*(1-r['energy_before'])*quality*duration
+            assert np.allclose(r['requested'],expected,rtol=0,atol=1e-18)
+    assert b.energy-initial.energy==pytest.approx(sum(r['transfer'].sum()-r['expenditure'] for r in events),rel=0,abs=2e-16)
+
+def test_oblique_event_subdivision_keeps_native_noise_and_field_cadence(monkeypatch):
+    import loom_p.engine as engine_module
+    c,b,s=fixture(.01,1e-5,1.); calls=[]
+    e=Engine.__new__(Engine); e.c=c; e.body=b; e.stocks=s; e.time=0.; e.phase=0.
+    e.raw=[np.zeros(d) for d in (10,4,8,7)]; e.fields=np.zeros((2,1,1))
+    def native(raw,dt,refresh_noise):
+        calls.append(('native_and_noise',dt,refresh_noise)); return np.ones(2)
+    def fields(old,stocks,t,phase,dt,position):
+        calls.append(('field',dt)); return old
+    e.organism=SimpleNamespace(native=native); e.solver=SimpleNamespace(step=fields)
+    monkeypatch.setattr(engine_module,'transduce',lambda *args:e.raw)
+    assert e._coupled(.01,True) is None
+    assert calls==[('native_and_noise',.01,True),('field',.01)]
+    assert e.time==.01 and len(e.last_events)==4
