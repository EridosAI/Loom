+        g=subprocess.run([sys.executable,'-B','-X','utf8','-m','pytest',test,'-q','-p','no:cacheprovider'],capture_output=True,text=True,encoding='utf-8')
+        (args.output/(name+'-GREEN.txt')).write_bytes((g.stdout+g.stderr).encode())
