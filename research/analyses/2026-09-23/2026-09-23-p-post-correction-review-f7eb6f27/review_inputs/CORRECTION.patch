+"""R1/R3 arithmetic fixtures; no additional complete-loop organism runs."""
+import copy
+import hashlib
+from types import SimpleNamespace
+import numpy as np
+import pytest
+from loom_p.schema import Config,Streams
+from loom_p.physics import Body,advance,actuator_forces,free_velocity
+from loom_p.geometry import fixtures,gap_normal,transduce
+from loom_p.neural import Organism
+from loom_p.engine import Engine
+from loom_p.records import state_bytes
+
+
+def touching_counterexample():
+    return Config(),Body(np.array([2.,3.]),0.,velocity=np.array([-.001,0.])),np.full(8,.2)
+
+
+def test_touch_release_return_duration_and_accounting():
+    c,b,stocks=touching_counterexample(); initial=copy.deepcopy(b)
+    force=actuator_forces(c,b,np.ones(2)); vinf=force.sum()/c.linear_drag
+    tr=np.log((vinf-b.velocity[0])/vinf)*c.body_mass/c.linear_drag
+    v,_=free_velocity(c,b,force,tr/2)
+    source=next(f for f in fixtures(c,0,0) if f['id']=='source-0')
+    gap,_=gap_normal(b.position+tr/2*v,c.body_radius,source)
+    assert gap>3000*c.geometry_tol
+    events,elapsed,terminal=advance(c,b,stocks,0.,0.,np.ones(2),.01)
+    releases=[r for r in events if r.get('event_kind')=='release']
+    assert releases and releases[0]['time']==0., 'Touching body must release at the start'
+    flights=[r for r in events if r['duration']>0 and not r['contacts']]
+    assert len(flights)==1, 'A finite free-flight interval must precede recontact'
+    # Swept search stops at geometry_tol, not at an exact zero-gap root. At this
+    # root |gap derivative| is about .001; 2e-7 s covers 1e-10 spatial resolution.
+    assert abs(flights[0]['duration']-tr)<2e-7
+    touches=[r for r in events if r.get('event_kind')=='recontact_or_first_touch']
+    assert len(touches)==1 and touches[0]['time']==flights[0]['time']
+    assert any(x['collider']=='source-0' for x in touches[0]['contacts'])
+    sustained=[r for r in events if r['duration']>0 and r['contacts']]
+    assert len(sustained)==1 and sustained[0]['duration']<.008686
+    assert elapsed==.01 and terminal is None
+    assert sum(r['duration'] for r in events)==pytest.approx(.01,abs=1e-16)
+    assert b.position[0]==pytest.approx(2.,abs=c.geometry_tol*2)
+    for r in events:
+        assert r['energy_after']-r['energy_before']==pytest.approx(r['transfer'].sum()-r['expenditure'],abs=1e-16)
+        assert np.allclose(r['stock_after']-r['stock_before'],r['renewal_first']+r['renewal_second']-r['transfer'],rtol=0,atol=1e-16)
+        expected=c.damage_per_impulse*sum(x['impulse'] if r['impact'] else max(x['impulse']-c.stress_threshold*r['duration'],0) for x in r['contacts'])
+        assert r['damage']==pytest.approx(expected,abs=1e-16)
+        assert r['integrity_after']-r['integrity_before']==pytest.approx(r['repair']-expected,abs=1e-16)
+        if r['impact'] or not r['contacts']: assert r['transfer'].sum()==0
+    assert b.energy-initial.energy==pytest.approx(sum(r['transfer'].sum()-r['expenditure'] for r in events),abs=1e-16)
+    assert sum(r['transfer'].sum() for r in events)<.00010415229960600089
+    # Damage need not decrease: the stress allowance also has shorter duration.
+    # The per-event constitutive oracle above, not a preferred outcome, is the gate.
+
+
+@pytest.mark.parametrize('velocity,angle',[([-.001,0.],np.pi),([0.,0.],np.pi),([0.,.1],0.)])
+def test_outward_or_tangent_source_release(velocity,angle):
+    c,b,s=touching_counterexample(); b.velocity=np.array(velocity); b.angle=angle
+    command=np.zeros(2) if velocity[1] else np.ones(2)
+    events,_,_=advance(c,b,s,0,0,command,.01)
+    assert any(r.get('event_kind')=='release' for r in events)
+    assert all(r['transfer'].sum()==0 for r in events)
+    assert b.position[0]<2 or b.position[1]>3
+
+
+def test_release_subdivision_does_not_repeat_native_or_noise(monkeypatch):
+    import loom_p.engine as engine_module
+    c,b,s=touching_counterexample(); calls=[]
+    e=Engine.__new__(Engine); e.c=c; e.body=b; e.stocks=s; e.time=0.; e.phase=0.
+    e.raw=[np.zeros(d) for d in (10,4,8,7)]; e.fields=np.zeros((2,1,1))
+    def native(raw,dt,refresh_noise):
+        calls.append(('native',dt,refresh_noise)); return np.ones(2)
+    def field(fields,stocks,t,phase,dt,position):
+        calls.append(('field',dt)); return fields
+    e.organism=SimpleNamespace(native=native); e.solver=SimpleNamespace(step=field)
+    monkeypatch.setattr(engine_module,'transduce',lambda *args:e.raw)
+    assert e._coupled(.01,True) is None
+    assert calls==[('native',.01,True),('field',.01)] and e.time==.01
+    assert any(r.get('event_kind')=='release' for r in e.last_events)
+
+
+@pytest.mark.parametrize('reference,target,tau',[('shared_ref','shared','tau_shared_reference'),('fine_ref','fine','tau_fine_reference')])
+def test_separate_sensory_reference_following(reference,target,tau):
+    c=Config(); raw=[np.zeros(d) for d in (10,4,8,7)]
+    o=Organism(c,Streams(c.master_seed),raw,np.array([.7,1.])); x=o.cortices[0]
+    setattr(x,reference,getattr(x,reference)*.5)
+    x.x[:]=np.linspace(-.4,.5,8); old=copy.deepcopy(x)
+    expected=getattr(old,reference)+(-np.expm1(-.01/getattr(c,tau)))*(getattr(old,target)-getattr(old,reference))
+    assert np.max(np.abs(expected-getattr(old,reference)))>1e-10
+    x.step(c,np.linspace(0,.9,10),np.array([.2,.8]),.01)
+    assert np.allclose(getattr(x,reference),expected,rtol=0,atol=1e-18), reference+' movement missing'
+    wrong=getattr(old,reference)+(-np.expm1(-.01/getattr(c,tau)))*(getattr(x,target)-getattr(old,reference))
+    assert np.max(np.abs(wrong-expected))>1e-15
+
+
+def arithmetic_engine():
+    c=Config(); e=Engine.__new__(Engine); e.c=c; e.time=0.; e.phase=0.
+    e.body=Body(np.array([5.,5.]),.3); e.stocks=np.full(8,.2)
+    e.raw=[np.linspace(.01,.3,d) for d in (10,4,8,7)]; e.fields=np.zeros((2,80,80))
+    e.organism=Organism(c,Streams(c.master_seed),e.raw,e.body.reserves)
+    e.solver=SimpleNamespace(step=lambda fields,*args:fields)
+    return e
+
+
+def neural_digest(o):
+    return hashlib.sha256(state_bytes([o.cortices,o.association,o.regulator,o.motor,o.native_count,o.wave_count,o.wave_elapsed])).hexdigest()
+
+
+class LearnerConfig:
+    """Adversarial proxy: shared config still contains world constants in production.
+    Verify executed learner arithmetic never requests those fields. Not a sandbox.
+    """
+    forbidden={'source_positions','source_capacity','world_side','mover_centre','repair_rectangles','birth_energy','grid_n','illumination_boundary'}
+    def __init__(self,c): self.config=c
+    def __getattr__(self,name):
+        assert name not in self.forbidden, 'Forbidden learner configuration read: '+name
+        return getattr(self.config,name)
+
