+def test_hidden_state_cannot_bypass_declared_transductions(monkeypatch):
+    import loom_p.engine as engine_module
+    a=arithmetic_engine(); b=arithmetic_engine(); fixed=copy.deepcopy(a.raw)
+    b.body.position[:]=[16.,14.]; b.body.angle=2.1; b.stocks[:]=.017
+    b.fields[:]=19.; b.time=42.; b.phase=2.8
+    b.c.source_positions=[[1.,1.]]; b.c.mover_centre=[18.,18.]
+    b.organism.rng.counters['life/world-position']=800
+    for e in (a,b): e.organism.c=LearnerConfig(e.c)
+    received=[]
+    def declared_transduction(c,body,fields,t,phase):
+        received.append((body.position.copy(),t,phase)); return copy.deepcopy(fixed)
+    monkeypatch.setattr(engine_module,'transduce',declared_transduction)
+    monkeypatch.setattr(engine_module,'advance',lambda c,body,stocks,t,phase,command,dt,allow:([],dt,None))
+    for _ in range(20):
+        a._coupled(.01,False); b._coupled(.01,False)
+        assert neural_digest(a.organism)==neural_digest(b.organism), 'Hidden world state entered native learner arithmetic'
+    for e in (a,b): e.organism.handoff(e.body.reserves)
+    assert neural_digest(a.organism)==neural_digest(b.organism), 'Hidden world state entered handoff arithmetic'
+    assert len(received)==40 and not np.array_equal(received[0][0],received[1][0])
