+<p class="muted">Saved review has no active world. The display supplies 29 raw coordinates; actual energy and integrity are held between 5 Hz samples. Privileged evaluation is a separate file.</p>
+<script>
+let data;const names=['Light · 10 coordinates','Chemistry · 4 coordinates','Contact · 8 coordinates','Proprioception · 7 coordinates'];const widths=[10,4,8,7];
+function render(){const idx=Number(document.querySelector('#at').value),row=data.history[idx];if(!row)return;document.querySelector('#state').textContent=data.availability==='offline_record'?'Paused saved review':'Paused between decisions';document.querySelector('#time').textContent=row.time.toFixed(3)+' s';document.querySelector('#body').textContent='Actual energy '+row.actual_EI[0].toFixed(6)+' · Actual integrity '+row.actual_EI[1].toFixed(6)+' · sampled at '+row.EI_sample_time.toFixed(3)+' s';document.querySelector('#channels').replaceChildren();let off=0;names.forEach((name,g)=>{let section=document.createElement('section');section.className='panel';let title=document.createElement('h2');title.textContent=name;section.append(title);let canvas=document.createElement('canvas');canvas.width=520;canvas.height=140;canvas.setAttribute('aria-label',name+' raw history');section.append(canvas);let table=document.createElement('table');for(let k=0;k<widths[g];k++){let tr=document.createElement('tr'),label=document.createElement('td'),value=document.createElement('td');label.textContent=data.raw_labels[off+k];value.textContent=row.raw[off+k].toPrecision(7);tr.append(label,value);table.append(tr)}section.append(table);document.querySelector('#channels').append(section);let ctx=canvas.getContext('2d'),start=Math.max(0,idx-999),samples=data.history.slice(start,idx+1),vals=samples.flatMap(r=>r.raw.slice(off,off+widths[g])),lo=Math.min(...vals),hi=Math.max(...vals);for(let k=0;k<widths[g];k++){ctx.strokeStyle=`hsl(${k*360/widths[g]},55%,40%)`;ctx.beginPath();samples.forEach((r,j)=>{let x=j*520/Math.max(1,samples.length-1),y=130-120*(r.raw[off+k]-lo)/Math.max(1e-12,hi-lo);j?ctx.lineTo(x,y):ctx.moveTo(x,y)});ctx.stroke()}off+=widths[g]});document.querySelector('#commands').textContent=data.own_commands.filter(x=>x.time<=row.time).map(x=>x.time.toFixed(3)+' s  ['+x.command.join(', ')+']').join('\n');document.querySelector('#send').disabled=data.availability!=='paused'}
