+document.querySelector('#at').oninput=render;document.querySelector('#send').onclick=async()=>{let response=await fetch('/command',{method:'POST',headers:{'Content-Type':'application/json'},body:JSON.stringify({left:Number(document.querySelector('#left').value),right:Number(document.querySelector('#right').value),annotation:document.querySelector('#note').value})});let result=await response.json();if(response.ok)accept(result);else document.querySelector('#message').textContent=result.message};document.querySelector('#download').onclick=()=>{let a=document.createElement('a');a.href=URL.createObjectURL(new Blob([JSON.stringify(data)],{type:'application/json'}));a.download='sensor-history.json';a.click();URL.revokeObjectURL(a.href)};fetch('/sensors').then(r=>r.json()).then(accept);
