+def test_recorder_fault_not_biological_event(tmp_path,monkeypatch):
+    e=fixture();r=Life(e,tmp_path/'fault',grant(e,20))
+    original=codec.write
+    def fail_chunk(path,*args,**kwargs):
+        if Path(path).name.startswith('chunk-'):raise OSError('injected recorder failure')
+        return original(path,*args,**kwargs)
+    monkeypatch.setattr(codec,'write',fail_chunk)
+    with pytest.raises(OSError):r.advance()
+    assert e.status!='terminal' and r.closed
+    assert (r.store/'failure-s000.json').is_file()
+    assert (r.store/'failure-tail-s000.ld').is_file()
+    with pytest.raises(ValueError):verify_store(r.store)
