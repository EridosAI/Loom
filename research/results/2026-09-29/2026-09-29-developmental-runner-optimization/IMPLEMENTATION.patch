+REQUEST=Path(os.environ.get('LOOM_ENGINEERING_REQUEST',r'C:\Users\Jason\.codex\attachments\400b7786-b3fc-4525-b4cb-f23c18150dff\Pasted text.txt'))
+
+def grant(e,end,parent=None):
+    g=create_engineering_grant(e,end,REQUEST,chunk_steps=20,checkpoint_stride=40)
+    g['parent_receipt_sha256']=parent;return g
+
+def test_exact_tier2_and_D5_from_saved_inputs(tmp_path):
+    initial=fixture();old=copy.deepcopy(initial);expected={};expected_d5={}
+    for i in range(1,61):
+        before=copy.deepcopy(old);n,w,events=old.step()
+        expected[i]=codec.encode(core.causal_state(old))
+        expected_d5[i]=codec.encode(passive(before,old,w,INTACT,None))
+    run=Life(initial,tmp_path/'life',grant(initial,60));run.advance()
+    assert verify_store(run.store)['native_steps']==60
+    checked=[]
+    def check(index,detached,diag):
+        assert codec.encode(core.causal_state(detached))==expected[index]
+        assert codec.encode(diag)==expected_d5[index];checked.append(index)
+    reconstruct(run.store,first_index=1,last_index=60,deep=True,fields=True,callback=check)
+    assert checked==list(range(1,61))
+    assert codec.encode(core.causal_state(run.engine))==expected[60]
+
+def test_continuous_vs_partial_wave_split_exact(tmp_path):
+    initial=fixture();a=Life(copy.deepcopy(initial),tmp_path/'continuous',grant(initial,60));a.advance()
+    b=Life(copy.deepcopy(initial),tmp_path/'split',grant(initial,7));b.advance()
+    for end in (20,60):
+        receipt=sorted(b.store.glob('segment-*.json'))[-1]
+        g=grant(b.engine,end,file_hash(receipt));b=Life.continue_life(b.store,g);b.advance()
+    assert codec.encode(core.causal_state(a.engine))==codec.encode(core.causal_state(b.engine))
+    assert verify_store(b.store)['native_steps']==60
+    assert verify_store(b.store)['segments']==3
