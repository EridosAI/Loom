+    for f in sorted(base.glob('python*.dll')):python_runtime[f.name]=file_hash(f)
+    for f in sorted((base/'DLLs').glob('*')):
+        if f.is_file() and f.suffix in ('.pyd','.dll'):
+            python_runtime['DLLs/'+f.name]=file_hash(f)
