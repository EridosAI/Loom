+    e=fixture();index=boundary*100-7;e.native_index=index;e.time=index*.01
+    e.organism.native_count=index;e.organism.wave_count=index//20;e.organism.wave_elapsed=(index%20)*.01
+    a=copy.deepcopy(e)
+    for _ in range(14):a.step()
+    run=Life(e,tmp_path/'life',grant(e,boundary*100));run.advance()
