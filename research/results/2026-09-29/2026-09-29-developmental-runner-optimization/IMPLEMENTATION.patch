+def test_terminal_resource_scope_and_corruption(tmp_path):
+    e=fixture();e.body.energy=1e-5;r=Life(e,tmp_path/'terminal',grant(e,10));r.advance()
+    assert r.receipt['status']=='terminal'
+    with pytest.raises(ValueError):Life.continue_life(r.store,grant(e,20,file_hash(r.store/'segment-000.json')))
+    e=fixture();g=grant(e,10);g['storage_limit_bytes']=16_000_000
+    r=Life(e,tmp_path/'resource',g);r.advance();assert e.native_index==0
+    assert r.receipt['status']=='resource_pause'
+    assert sum(f.stat().st_size for f in r.store.iterdir() if f.is_file())<g['storage_limit_bytes']
+    with pytest.raises(ValueError):Life(fixture(),tmp_path/'impossible-resource',dict(grant(fixture(),10),storage_limit_bytes=100))
+    with pytest.raises(ValueError):Life(e,tmp_path/'bad',dict(g,end_index=0))
+    e=fixture();r=Life(e,tmp_path/'corrupt',grant(e,10));r.advance()
+    chunk=next(r.store.glob('chunk-*.ld'));blob=bytearray(chunk.read_bytes());blob[-1]^=1;chunk.write_bytes(blob)
+    with pytest.raises(ValueError):verify_store(r.store)
