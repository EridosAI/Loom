+"""Only the three reproduced residuals; no commissioning execution."""
+import copy,gzip,json,math,os,shutil
+from contextlib import nullcontext
+from pathlib import Path
+from unittest.mock import patch
+import numpy as np
+import pytest
+from test_apparatus import manufactured
+from test_corrections import grant_fixture, PLAN
+from loom_p.records import state_hash,pack,unpack,strict_bytes
+from loom_p.chemistry import FieldSolver
+from loom_commissioning import authority,controllers,runner,pending,validators,adapter
+from loom_commissioning.contract import make_manifest,validate_manifest,authorize_execution,digest,EXTERNAL
+
+def mutant(name,obj,attr,replacement):
+    return patch.object(obj,attr,replacement) if os.environ.get('FINAL_FAULT')==name else nullcontext()
+
+def rejected(call):
+    try: call()
+    except ValueError:return True
+    return False
+
+def unchecked_dispatch(m,namespace):
+    return {name:namespace[name] for name in ('waypoint_command','privileged_input','command_pair','time_due','observe_without_interference','SensorHistory')}
+
+def rebind_request(m,path,raw):
+    path.write_bytes(raw)
+    m['execution_authority']['request_path']=str(path)
+    m['execution_authority']['request_sha256']=digest(raw)
+
+@pytest.mark.parametrize('name',['approved_execution','point','controller','until','identical'])
+def test_duplicate_approval_rejection(tmp_path,name):
+    e,m,path=grant_fixture(tmp_path);clean=path.read_bytes();before=state_hash(e)
+    if name=='approved_execution':
+        good=authority.execution_object(m);bad=copy.deepcopy(good);bad['execution']['procedure']['stages'][0]['point']=[4.,5.]
+        needle=b'"approved_execution":'+authority.canonical(good)
+        raw=clean.replace(needle,b'"approved_execution":'+authority.canonical(bad)+b','+needle)
+    else:
+        needle,conflict={'point':(b'"point":[6.0,5.0]',b'"point":[4.0,5.0]'),
+            'controller':(b'"controller":"waypoint"',b'"controller":"manual_privileged"'),
+            'until':(b'"until":0.1',b'"until":0.15'),
+            'identical':(b'"point":[6.0,5.0]',b'"point":[6.0,5.0]')}[name]
+        assert clean.count(needle)==1
+        raw=clean.replace(needle,conflict+b','+needle)
+    assert raw!=clean
+    rebind_request(m,path,raw)
+    with mutant('duplicate-'+name,authority,'strict_loads',json.loads):
+        assert rejected(lambda:authorize_execution(m)), 'DUPLICATE APPROVAL BREACH: '+name
+    with patch.object(runner,'Recorder',side_effect=AssertionError('trajectory output reached')):
+        assert rejected(lambda:runner.Run(e,m,tmp_path/'forbidden'))
+    assert not (tmp_path/'forbidden').exists() and state_hash(e)==before and e.native_index==0
+    rebind_request(m,path,clean);validate_manifest(m,e);authorize_execution(m)
+
+@pytest.mark.parametrize('name',['SYNTHETIC_duplicate-approved-execution_NO_EXECUTION.json',
+                                  'SYNTHETIC_duplicate-nested-waypoint_NO_EXECUTION.json'])
+def test_exact_review_raw_duplicates(name):
+    raw=(Path(__file__).parent/'fixtures/final_review'/name).read_bytes()
+    with pytest.raises(ValueError,match='duplicate JSON field'):authority.strict_loads(raw)
+
+def test_non_string_canonical_key():
+    legacy=lambda x:json.dumps(x,sort_keys=True,separators=(',',':'),allow_nan=False).encode()
+    with mutant('canonical-keys',authority,'canonical',legacy):
+        assert rejected(lambda:authority.canonical({'protocol':{1:'first declared procedure step'}})), 'CANONICAL KEY BREACH'
+    assert authority.strict_loads(authority.canonical({'protocol':{'1':'first declared procedure step'}}))=={'protocol':{'1':'first declared procedure step'}}
+
+def test_alias_and_semantic_mirror_rejection(tmp_path):
+    e,m,path=grant_fixture(tmp_path);clean=path.read_bytes()
+    for key,value in [('controller','manual_privileged'),('route',[]),('approved_manifest',{})]:
+        doc=json.loads(clean);doc[key]=value;rebind_request(m,path,authority.canonical(doc))
+        with mutant('approval-alias',authority,'read_approval',authority.strict_loads):
+            assert rejected(lambda:authorize_execution(m)), 'APPROVAL ALIAS BREACH'
+    rebind_request(m,path,clean)
+    for field,value in [('controller','manual_privileged'),('mode','intact_P')]:
+        other=copy.deepcopy(m);other[field]=value
+        assert rejected(lambda:validate_manifest(other,e))
+    authorize_execution(m)
+
+def test_protocol_cannot_shadow_bound_fields(tmp_path):
+    e,m,path=grant_fixture(tmp_path)
+    for key,value in [('controller','manual_privileged'),('route',[]),('intervention','chemistry_hidden')]:
+        other=copy.deepcopy(m);other['execution']['procedure']['protocol']={'steps':[{'action':'description',key:value}]}
+        with mutant('protocol-shadow',authority,'validate_protocol_fields',lambda *a:None):
+            assert rejected(lambda:authority.validate_execution(other,complete=True)), 'PROTOCOL SHADOW BREACH'
+        with patch.object(runner,'Recorder',side_effect=AssertionError('output reached')):
+            assert rejected(lambda:runner.Run(e,other,tmp_path/'forbidden'))
+    assert not (tmp_path/'forbidden').exists()
+    authorize_execution(m)
+
+@pytest.mark.parametrize('name',['waypoint_command','command_pair','privileged_input','time_due','observe_without_interference'])
+def test_actual_dispatch_is_checked(tmp_path,name):
+    e=manufactured();m=make_manifest(e,'fixture-dispatch',EXTERNAL,'waypoint',.2,plan=PLAN)
+    run=runner.Run(e,m,tmp_path/'run');original=getattr(runner,name);calls=[];before=state_hash(e)
+    def proxy(*args,**kwargs): calls.append(name);return original(*args,**kwargs)
+    proxy.__name__=proxy.__qualname__=name
+    try:
+        with patch.object(runner,name,proxy),mutant('dispatch-'+name,runner,'validate_dispatch',unchecked_dispatch):
+            rejected(run.begin_command)
+            assert not calls, 'EXECUTED DISPATCH BREACH: '+name
+        assert state_hash(e)==before and not run.sensor.payload['own_commands']
+        run.begin_command()
+        expected,_=controllers.waypoint_command(controllers.privileged_input(e),copy.deepcopy(PLAN),0)
+        assert run.session['held_command']==expected.tolist()
+    finally:
+        run.close()
+
+def test_dispatch_changed_between_check_and_use(tmp_path):
+    e=manufactured();m=make_manifest(e,'fixture-captured-dispatch',EXTERNAL,'waypoint',.2,plan=PLAN)
+    run=runner.Run(e,m,tmp_path/'run');real=runner.validate_dispatch;original=runner.waypoint_command;calls=[]
+    def other(*args):calls.append('unapproved');return np.array([-.5,.5]),0
+    def switch_after_check(manifest,namespace):
+        captured=real(manifest,namespace)
+        runner.waypoint_command=other
+        return captured
+    before=state_hash(e)
+    try:
+        with patch.object(runner,'validate_dispatch',switch_after_check):
+            assert rejected(run.begin_command)
+        assert calls==[] and state_hash(e)==before and not run.sensor.payload['own_commands']
+    finally:runner.waypoint_command=original;run.close()
+
+def test_gateway_rejects_duplicate_command_fields():
+    import threading,urllib.request,urllib.error
+    from http.server import HTTPServer
+    from loom_commissioning.sensor_ui import handler
+    class Gateway:
+        def __init__(self):self.calls=0
+        def submit(self,*args):self.calls+=1;return controllers.SensorHistory(manufactured()).display()
+    gateway=Gateway();server=HTTPServer(('127.0.0.1',0),handler(gateway));thread=threading.Thread(target=server.serve_forever,daemon=True);thread.start()
+    try:
+        origin=f'http://127.0.0.1:{server.server_port}'
+        req=urllib.request.Request(origin+'/command',data=b'{"left":0.5,"left":-0.5,"right":0,"annotation":""}',
+            headers={'Origin':origin,'Content-Type':'application/json'},method='POST')
+        with pytest.raises(urllib.error.HTTPError) as error:urllib.request.urlopen(req)
+        assert error.value.code==400 and gateway.calls==0
+    finally:server.shutdown();server.server_close();thread.join()
+
+def test_post_approval_constants_and_route(tmp_path):
+    e=manufactured();m=make_manifest(e,'fixture-live-spec',EXTERNAL,'waypoint',.2,plan=PLAN)
+    run=runner.Run(e,m,tmp_path/'run');before=state_hash(e)
+    with patch.dict(controllers.WAYPOINT_SETTINGS,{'heading_gain':.81}):
+        assert rejected(run.begin_command)
+    run.session['route'][0]['point']=[4.,5.]
+    assert rejected(run.begin_command)
+    run.session['route']=copy.deepcopy(PLAN)
+    assert state_hash(e)==before and not run.sensor.payload['own_commands']
+    run.close()
+
+@pytest.mark.parametrize('name',['command','remainder','both','decision'])
+def test_pending_mutation_before_advance_and_save(tmp_path,name):
+    e=manufactured();m=make_manifest(e,'fixture-persisted-held',EXTERNAL,'waypoint',.2,plan=PLAN)
+    run=runner.Run(e,m,tmp_path/'first');run.begin_command();run.advance(7)
+    saved=copy.deepcopy(run.session);before=state_hash(e)
+    if name in ('command','both'):run.session['held_command']=[-.5,.5]
+    if name in ('remainder','both'):run.session['hold_remaining']=4
+    if name=='decision':
+        run.session['decision']['inputs']['position']=[7.,5.]
+        command,_=controllers.waypoint_command(run.session['decision']['inputs'],copy.deepcopy(PLAN),0)
+        run.session['decision']['command']=command.tolist();run.session['held_command']=command.tolist()
+    try:
+        with mutant('pending-'+name,runner,'validate_pending',lambda *a:None):
+            assert rejected(run._guard), 'PENDING COMMAND BREACH: '+name
+        with patch.object(adapter,'step',side_effect=AssertionError('world step reached')):
+            assert rejected(run.hold)
+        assert rejected(run.close)
+        assert state_hash(e)==before and e.native_index==7 and not (tmp_path/'first/final.restart.json.gz').exists()
+    finally:
+        run.session.clear();run.session.update(saved);run.sensor.__dict__=run.session['sensor'];run.close()
+    loaded,s,mm=runner.load_restart(tmp_path/'first/final.restart.json.gz')
+    s['held_command']=[-.5,.5];s['hold_remaining']=4
+    with patch.object(runner,'Recorder',side_effect=AssertionError('resume output reached')):
+        assert rejected(lambda:runner.Run(loaded,mm,tmp_path/'bad',session=s))
+    assert not (tmp_path/'bad').exists()
+
+def test_resume_binding_and_stage_transition(tmp_path):
+    e=manufactured();m=make_manifest(e,'fixture-resume-execution',EXTERNAL,'waypoint',.2,plan=PLAN)
+    first=runner.Run(e,m,tmp_path/'first');first.begin_command();issued=first.session['held_command'].copy();first.advance(7);first.close()
+    def proxy(*args):return controllers.waypoint_command(*args)
+    with patch.object(runner,'waypoint_command',proxy):
+        assert rejected(lambda:runner.Run.resume(tmp_path/'first',tmp_path/'bad-controller'))
+    assert not (tmp_path/'bad-controller').exists()
+    resumed=runner.Run.resume(tmp_path/'first',tmp_path/'resumed');assert resumed.session['hold_remaining']==3
+    before_neural=state_hash(resumed.engine.organism);fields=[];real=FieldSolver.step
+    def count(self,*a,**k):fields.append(a[4]);return real(self,*a,**k)
+    with patch.object(FieldSolver,'step',count):
+        resumed.hold();assert resumed.engine.native_index==10 and resumed.engine.body.command.tolist()==issued
+        # Exact pending-count corruption at the boundary is rejected. Returning
+        # to its intact issued-decision remainder permits only a fresh stage call.
+        resumed.session['hold_remaining']=1;before=state_hash(resumed.engine)
+        assert rejected(resumed.hold) and state_hash(resumed.engine)==before
+        resumed.session['hold_remaining']=0;resumed.hold()
+    assert fields==[.01]*13 and resumed.engine.native_index==20
+    assert abs(resumed.engine.time-.2)<1e-15 and resumed.engine.body.command.tolist()!=issued
+    assert state_hash(resumed.engine.organism)==before_neural
+    assert validators.read_stream(tmp_path/'resumed/wave.jsonl.gz')==[]
+    assert validators.verify_segment(tmp_path/'first')['native_records']==7
+    assert validators.verify_segment(tmp_path/'resumed')['native_records']==13
+
+@pytest.mark.parametrize('time,index,remaining,valid',[(.07,7,3,True),(.09,9,2,False),
+    (.1,10,1,False),(.1-5e-11,10,1,False),(math.nextafter(.1,math.inf),10,1,False)])
+def test_saved_pending_boundary_preflight(tmp_path,time,index,remaining,valid):
+    e=manufactured();m=make_manifest(e,'fixture-saved-boundary-input',EXTERNAL,'waypoint',.2,plan=PLAN)
+    run=runner.Run(e,m,tmp_path/'first');run.begin_command();run.advance(7);run.close()
+    loaded,s,mm=runner.load_restart(tmp_path/'first/final.restart.json.gz')
+    # Detached manufactured saved-state clock/remaining inputs; no claim these
+    # injected clocks form a reconstructed physical trajectory.
+    loaded.time=time;loaded.native_index=index;s['hold_remaining']=remaining
+    before=state_hash(loaded)
+    assert rejected(lambda:pending.validate_pending(mm,s,loaded)) is (not valid)
+    assert state_hash(loaded)==before
+    if index==10:
+        s['hold_remaining']=0;pending.validate_pending(mm,s,loaded)
+        _,next_stage=controllers.waypoint_command(controllers.privileged_input(loaded),copy.deepcopy(PLAN),0)
+        assert next_stage==1
+
+def test_saved_decision_journal_rejection(tmp_path):
+    e=manufactured();m=make_manifest(e,'fixture-record-continuity',EXTERNAL,'waypoint',.2,plan=PLAN)
+    run=runner.Run(e,m,tmp_path/'good');run.begin_command();run.advance(7);run.close()
+    shutil.copytree(tmp_path/'good',tmp_path/'bad')
+    p=tmp_path/'bad/final.restart.json.gz';wrapper=json.loads(gzip.decompress(p.read_bytes()));state=unpack(wrapper['state'])
+    d=state['session']['decision'];d['inputs']['position']=[7.,5.]
+    command,_=controllers.waypoint_command(d['inputs'],copy.deepcopy(PLAN),0)
+    d['command']=command.tolist();state['session']['held_command']=command.tolist()
+    # Coherent altered pending payload with honest new checksums: the original
+    # action journal must still reject it, even without replaying physical steps.
+    wrapper['state']=pack(state);wrapper['sha256']=digest(strict_bytes(wrapper['state']))
+    raw=gzip.compress(strict_bytes(wrapper),mtime=0);p.write_bytes(raw)
+    receipt=json.loads((tmp_path/'bad/manifest.json').read_bytes())
+    receipt['files'][p.name]={'bytes':len(raw),'sha256':digest(raw)}
+    (tmp_path/'bad/manifest.json').write_bytes(strict_bytes(receipt))
+    with mutant('decision-journal',validators,'validate_journal',lambda *a:None):
+        assert rejected(lambda:validators.verify_segment(tmp_path/'bad',replay=False)), 'DECISION JOURNAL BREACH'
+    assert rejected(lambda:runner.Run.resume(tmp_path/'bad',tmp_path/'bad-resume'))
+    assert not (tmp_path/'bad-resume').exists()
+    validators.verify_segment(tmp_path/'good')
+
+def test_duplicate_packed_pending_key(tmp_path):
+    e=manufactured();m=make_manifest(e,'fixture-packed-key',EXTERNAL,'waypoint',.1,plan=PLAN[:1])
+    run=runner.Run(e,m,tmp_path/'record');run.begin_command();run.close()
+    p=tmp_path/'record/final.restart.json.gz';wrapper=json.loads(gzip.decompress(p.read_bytes()))
+    state_pairs=wrapper['state']['$dict'];session=next(v for k,v in state_pairs if k=='session')
+    session['$dict'].append(['hold_remaining',11])
+    wrapper['sha256']=digest(strict_bytes(wrapper['state']));p.write_bytes(gzip.compress(strict_bytes(wrapper),mtime=0))
+    with pytest.raises(ValueError,match='duplicate packed state key'):runner.load_restart(p)
